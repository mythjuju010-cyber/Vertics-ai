  .mobile-nav .nav-link svg { width: 18px; height: 18px; }
  .overview-grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 11px; }
  .span-3, .span-4, .span-5, .span-6, .span-7, .span-8, .span-12 { grid-column: span 2; }
  .hero-panel { min-height: 230px; padding: 23px; }
  .signal-grid { grid-template-columns: 1fr; }
  .section-head { align-items: flex-start; flex-direction: column; }
  .top-actions .badge { display: none; }
  .landing-nav { padding: 18px 20px; }
  .landing-main { padding: 3vh 20px 60px; }
  .landing-hero { grid-template-columns: 1fr; min-height: 0px; }
  .landing-hero h1 { font-size: clamp(47px, 13vw, 72px); }
  .landing-copy { font-size: 14px; }
  .market-orbit { height: 250px; transform: scale(0.68); margin: -15px 0px; }
  .feature-grid { grid-template-columns: 1fr; }
  .landing-section { padding: 48px 0px; }
  .landing-footer { flex-direction: column; }
  .instrument-card { grid-template-columns: 1fr auto; }
  .instrument-card .badge { grid-column: 1 / -1; width: max-content; }
  .data-pair { grid-template-columns: repeat(2, 1fr); }
}


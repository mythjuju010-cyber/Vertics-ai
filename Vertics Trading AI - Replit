  .main { width: 100%; margin: 0px; padding: 22px 17px 100px; }
  .topbar { margin-bottom: 25px; }
  .mobile-nav { position: fixed; z-index: 30; bottom: 0px; left: 0px; right: 0px; display: flex; justify-content: space-around; gap: 2px; padding: 9px 5px calc(9px + env(safe-area-inset-bottom)); background: rgba(22, 18, 31, 0.96); border-top: 1px solid rgba(255, 255, 255, 0.075); backdrop-filter: blur(18px); }
